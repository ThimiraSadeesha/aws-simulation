# Copy to .env and adjust:  cp .env.example .env
# Shared secret between backend and simulation engine. REQUIRED. Generate one with:
#   openssl rand -hex 32
ENGINE_TOKEN=change-me-to-a-long-random-string

# Host ports (bound to 127.0.0.1 by default; the engine is never published).
CONSOLE_PORT=3000
BACKEND_PORT=8080
# CONSOLE_BIND=127.0.0.1
# BACKEND_BIND=127.0.0.1

# Simulation speed: 1.0 = realistic delays (instance boot ~3s), 0.2 = 5x faster, 0 = instant.
ENGINE_TIME_SCALE=1.0
ENGINE_SEED=42

# Platform settings
ALLOW_REGISTRATION=true        # first registered user becomes platform admin
SECURE_COOKIES=false           # set true when served over HTTPS
SESSION_TTL=24h
RATE_LIMIT_RPS=50
MAX_OBJECT_SIZE=104857600      # 100 MiB per S3 object
# Key for encrypting Secrets Manager values at rest (32+ random chars). If empty, a key file is
# generated inside the data volume.
SECRETS_KEY=

BACKEND_LOG_LEVEL=info
ENGINE_LOG_LEVEL=info
